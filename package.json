{
  "name": "mouthlife-plaque-dimension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MouthLife: The Plaque Dimension — Mobile-first 3D biophysical dental arcade & Smooth Bask companion",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:test": "tsc --noEmit && VITE_TEST_BUILD=1 vite build",
    "android:sync": "node scripts/android-sync.mjs",
    "android:sync:test": "node scripts/android-sync.mjs --test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:translate": "node scripts/i18n-translate.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@types/node": "^22.20.5",
    "@types/three": "^0.174.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
