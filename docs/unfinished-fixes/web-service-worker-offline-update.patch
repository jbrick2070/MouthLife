+    ['/MouthLife/assets/… from the top of the site', (v, site) => `<script type="module" src="${new URL(site.base).pathname}assets/index-${v}.js"></script>`],
+    ['a full https address', (v, site) => `<script type="module" src="${site.base}assets/index-${v}.js"></script>`],
+    ['an address without https:', (v, site) => `<script type="module" src="${site.base.replace('https:', '')}assets/index-${v}.js"></script>`],
+    ['a name with a ?query', (v) => `<script type="module" src="./assets/index-${v}.js?v=7"></script>`],
+    ['a name with a two-part ?query', (v) => `<script type="module" src="./assets/index-${v}.js?a=1&amp;b=2"></script>`],
+    ['a name with a #part', (v) => `<script type="module" src="./assets/index-${v}.js#main"></script>`],
+    ['single quotes', (v) => `<script type='module' src='./assets/index-${v}.js'></script>`],
+    ['no quotes', (v) => `<script type=module src=./assets/index-${v}.js></script>`],
+    ['capital letters', (v) => `<SCRIPT TYPE="module" SRC="./assets/index-${v}.js"></SCRIPT>`],
+    ['spaces round the equals sign', (v) => `<script type="module" src = "./assets/index-${v}.js"></script>`],
