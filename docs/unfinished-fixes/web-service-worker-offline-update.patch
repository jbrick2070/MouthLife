+/** A phone that has been to the game once, on a good connection, and so holds build V1. */
+async function phoneWithV1(site = new Site()): Promise<Phone> {
+  site.deploy('V1');
+  const phone = new Phone(site);
+  expect(await phone.open({ online: true })).toEqual(startsWith('V1'));
+  return phone;
+}
