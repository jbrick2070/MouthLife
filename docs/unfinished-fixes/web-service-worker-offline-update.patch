+// ---------------------------------------------------------------------------------------------
+// The phone
+// ---------------------------------------------------------------------------------------------
+
+interface Launch {
+  /** Which build's page the browser was given; 'none' is the browser's own "no connection" screen. */
+  page: string;
+  /** Which build's game script ran; 'none' with a page is a blank screen. */
+  script: string;
+  started: boolean;
+  /** Files the page needed and did not get. */
+  missing: string[];
+}
+
+interface LaunchOptions {
+  online: boolean;
+  /** The connection is lost as soon as the page itself has arrived. */
+  cutAfterPage?: boolean;
+  /** False for a browser that cannot list what the page loaded, so the page has nothing to report. */
+  reports?: boolean;
+  /** When a changed sw.js on the host is installed, compared with the page's report. */
+  update?: 'before the report' | 'during the report' | 'after the report';
+  /** The address opened, after the game's folder: '' (the default), 'index.html', '?from=homescreen'. */
+  at?: string;
+  /** Runs when the page has arrived and the worker has done what it does with it, before any bundle. */
+  whenPageArrived?: () => Promise<void>;
+}
+
+const startsWith = (version: string): Launch => ({ page: version, script: version, started: true, missing: [] });
+
+/** One installed copy of the game: a store and the worker in control of it. */
+class Phone {
+  readonly store: FakeCacheStorage;
+  /** The worker in control of the page; none before the first visit. */
+  worker: WorkerInstance | null = null;
+  private revision = 0;
+
+  constructor(readonly site: Site) {
+    this.store = new FakeCacheStorage(site);
+  }
+
+  /** The browser finds a changed sw.js on the host, installs it, and it takes over at once. */
+  async updateCheck(): Promise<void> {
+    if (!this.site.online || this.revision === this.site.workerRevision) return;
+    const next = new WorkerInstance(this.site, this.store);
+    await next.dispatch('install');
+    await next.dispatch('activate');
+    this.worker = next;
+    this.revision = this.site.workerRevision;
+  }
+
+  /** One launch from start to finish. */
+  async open(how: LaunchOptions): Promise<Launch> {
+    const { site } = this;
+    site.online = how.online;
+    const ask = (request: PretendRequest): Promise<Response> => (this.worker ? this.worker.fetch(request) : site.fetch(request));
+
+    const pageUrl = site.base + (how.at ?? '');
+    let html: string;
+    try {
+      const answer = await ask(navigation(pageUrl));
+      if (!answer.ok) return { page: `HTTP ${answer.status}`, script: 'none', started: false, missing: [] };
+      html = await answer.text();
+    } catch {
+      await settle(site);
+      return { page: 'none', script: 'none', started: false, missing: [] };
+    }
+    await settle(site);
+    if (how.whenPageArrived) await how.whenPageArrived();
+    if (how.cutAfterPage) site.online = false;
+
+    const loaded: string[] = [];
+    const missing: string[] = [];
+    let script = 'none';
+    let scripts = 0;
+    let scriptsMissing = 0;
+    for (const file of filesThePageLoads(html, pageUrl)) {
+      const url = site.address(file.url);
+      if (site.skippedByBrowsers.has(url.slice(site.base.length)) || site.skippedByBrowsers.has(url)) continue;
+      if (file.kind === 'script') scripts++;
+      let arrived = false;
+      try {
+        const answer = await ask(subresource(url));
+        const text = await answer.text();
+        // A browser refuses a script that is served as a web page, and a style sheet likewise.
+        arrived = answer.ok && (file.kind === 'script' ? /javascript/ : /css/).test(answer.headers.get('content-type') ?? '');
+        if (arrived) script = /\/\* app (\w+) \*\//.exec(text)?.[1] ?? script;
+      } catch {
+        arrived = false;
+      }
+      if (arrived) loaded.push(url);
+      else {
+        missing.push(url.slice(site.base.length));
+        if (file.kind === 'script') scriptsMissing++;
+      }
+    }
+    await settle(site);
+    const started = scripts > 0 && scriptsMissing === 0;
+
+    if (started) {
+      // src/main.ts, on load: register ./sw.js, then tell the worker which bundles this visit loaded.
+      const report = async (to: WorkerInstance | null): Promise<void> => {
+        if (to && how.reports !== false && loaded.length > 0) await to.message({ type: 'precache', urls: loaded });
+      };
+      const order = this.worker ? (how.update ?? 'after the report') : 'before the report';
+      if (order === 'before the report') {
+        await this.updateCheck();
+        await report(this.worker);
+      } else if (order === 'during the report') {
+        const sent = report(this.worker);
+        await this.updateCheck();
+        await sent;
+      } else {
+        await report(this.worker);
+        await this.updateCheck();
+      }
+      // Then the page warms up what a first visit never asks for: other languages, guide pictures.
+      for (const url of site.lazy()) {
+        await ask(subresource(url))
+          .then((answer) => answer.arrayBuffer())
+          .catch(() => undefined);
+      }
+    } else {
+      await this.updateCheck(); // the browser looks for a new worker whether or not the page starts
+    }
+    await settle(site);
+    return { page: versionOf(html), script: started ? script : 'none', started, missing };
+  }
+
+  /** Which build's page is stored under a name ('./' or './index.html'); 'none' when nothing is. */
+  pageAt(name: string): string {
+    const hit = this.store.caches.get(STORE_NAME)?.peek(name);
+    return hit ? versionOf(new TextDecoder().decode(hit.body)) : 'none';
+  }
+
+  /** Whether a file of the game ('assets/index-V1.js') is stored. */
+  has(path: string): boolean {
+    return Boolean(this.store.caches.get(STORE_NAME)?.peek(this.site.base + path));
+  }
+
+  /** Everything stored for the game, as short names. */
+  storedFiles(): string[] {
+    const stored = this.store.caches.get(STORE_NAME)?.stored ?? new Map<string, StoredAnswer>();
+    return [...stored.keys()].map((url) => url.slice(this.site.base.length) || './').sort();
+  }
+}
