index 0000000..26b4c5b
--- /dev/null
+++ b/tests/serviceWorker.test.ts
@@ -0,0 +1,1225 @@
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { afterAll, afterEach, beforeAll, describe, expect, it } from 'vitest';
+
+// The browser runs public/sw.js by itself, outside the page, so it cannot be imported like the rest
+// of the game. These tests read the real file and run its text inside a pretend phone: a host that
+// can be updated and cut off, the browser's file store, and a page that loads what its HTML names
+// the way the built page does (src/main.ts registers ./sw.js on load and reports its bundles).
+// None of the worker's rules are repeated here: only what a player would get is checked.
+const WORKER_SOURCE = readFileSync(join(__dirname, '..', 'public/sw.js'), 'utf8');
+
+/** Phones in the field keep their game under this name; a worker that looks elsewhere strands them. */
+const STORE_NAME = 'mouthlife-shell-v3';
+const LANGUAGES = ['de', 'es', 'fr', 'ja', 'ko', 'pt', 'zh'];
+const PICTURES = ['t-plaque-DTRyxbod.jpg', 'home-DG65wR2T.jpg'];
+const SHELL_FILES = ['manifest.webmanifest', 'icon.svg', 'apple-touch-icon.png', 'icon-192.png', 'icon-512.png', 'privacy.html'];
+
+// ---------------------------------------------------------------------------------------------
+// The page
+// ---------------------------------------------------------------------------------------------
+
+/** The three lines the build adds to the page (see dist/index.html after `npm run build`). */
+const builtHead = (version: string, three = 'AAA'): string => `    <script type="module" crossorigin src="./assets/index-${version}.js"></script>
+    <link rel="modulepreload" crossorigin href="./assets/three-${three}.js">
+    <link rel="stylesheet" crossorigin href="./assets/index-${version}.css">`;
+
+/** The game's page around those lines. The closing comment tells a test which build a page is. */
+const pageWith = (version: string, head: string): string => `<!DOCTYPE html>
+<html lang="en">
+  <head>
+    <meta charset="UTF-8" />
+    <meta property="og:image" content="./og-card.png" />
+    <link rel="manifest" href="./manifest.webmanifest" />
+    <link rel="icon" type="image/svg+xml" href="./icon.svg" />
+    <link rel="apple-touch-icon" sizes="180x180" href="./apple-touch-icon.png" />
+    <title>MouthLife: The Plaque Dimension</title>
+${head}
+  </head>
+  <body>
+    <div id="app">
+      <canvas id="mouthlife-canvas" aria-label="MouthLife 3D Viewport"></canvas>
+      <div id="ui-root"></div>
+    </div>
+    <!-- build ${version} -->
+  </body>
+</html>`;
+
+const versionOf = (html: string): string => /<!-- build (\w+) -->/.exec(html)?.[1] ?? '?';
+
+interface PageFile {
+  url: string;
+  kind: 'script' | 'style';
+}
+
+/** What a browser loads before this page can start: its scripts and style sheets, read tag by tag. */
+function filesThePageLoads(html: string, pageUrl: string): PageFile[] {
+  const files: PageFile[] = [];
+  const visible = html.replace(/<!--[\s\S]*?-->/g, '');
+  for (const tag of visible.match(/<(?:script|link)\b[^>]*>/gi) ?? []) {
+    const value = (name: string): string | undefined => {
+      const found = new RegExp(`\\s${name}\\s*=\\s*(?:"([^"]*)"|'([^']*)'|([^\\s>]+))`, 'i').exec(tag);
+      return found ? (found[1] ?? found[2] ?? found[3]).replace(/&amp;/g, '&') : undefined;
+    };
+    const isScript = /^<script/i.test(tag);
+    const name = value(isScript ? 'src' : 'href');
+    const rel = (value('rel') ?? '').toLowerCase();
+    if (!name || (!isScript && rel !== 'stylesheet' && rel !== 'modulepreload')) continue;
+    try {
+      files.push({ url: new URL(name, pageUrl).href, kind: isScript || rel === 'modulepreload' ? 'script' : 'style' });
+    } catch {
+      // Not an address at all: a browser leaves such a tag alone.
+    }
+  }
+  return files;
+}
+
+// ---------------------------------------------------------------------------------------------
+// The host
+// ---------------------------------------------------------------------------------------------
+
+type Ask = string | { url: string; method?: string; mode?: string };
+
+interface DeployOptions {
+  /** A page written differently from the build's; gets the version, returns the whole HTML. */
+  page?: (version: string) => string;
+  /** The hash of the three.js chunk, which most updates leave alone. */
+  three?: string;
+  /** This update also changed sw.js, so browsers install the worker again. */
+  workerChanged?: boolean;
+  /** Files the page names that a browser never asks for (a hint it skips, a file on another site). */
+  skippedByBrowsers?: string[];
+  /** Files that should be on the host and are not. */
+  without?: string[];
+}
+
+/** The static host. An update replaces every file, as GitHub Pages does: the old hashed bundles are gone. */
+class Site {
+  readonly workerUrl: string;
+  files = new Map<string, { body: string; type: string }>();
+  online = true;
+  /** Every path the host was asked for, in order ('' is the page itself). */
+  asked: string[] = [];
+  workerRevision = 0;
+  skippedByBrowsers = new Set<string>();
+  /** When set, the copy of the page that a worker keeps for storing cannot be read. */
+  pageCopyCannotBeRead = false;
+  /** When set, a plain request for the page is answered with a redirect to it, which is followed. */
+  redirectsThePage = false;
+  /** Downloads, writes and promises a worker asked the browser to wait for, still going on. */
+  busy = 0;
+
+  constructor(readonly base = 'https://kids.example/MouthLife/') {
+    this.workerUrl = `${base}sw.js`;
+  }
+
+  deploy(version: string, options: DeployOptions = {}): void {
+    const three = options.three ?? 'AAA';
+    const page = options.page ? options.page(version) : pageWith(version, builtHead(version, three));
+    const files = new Map<string, { body: string; type: string }>();
+    const put = (path: string, body: string, type: string): void => void files.set(path, { body, type });
+    put('', page, 'text/html; charset=utf-8');
+    put('index.html', page, 'text/html; charset=utf-8');
+    put(`assets/index-${version}.js`, `/* app ${version} */`, 'application/javascript');
+    put(`assets/three-${three}.js`, `/* three ${three} */`, 'application/javascript');
+    put(`assets/index-${version}.css`, `/* look ${version} */`, 'text/css');
+    for (const language of LANGUAGES) put(`assets/${language}-${version}.js`, `/* ${language} ${version} */`, 'application/javascript');
+    for (const picture of PICTURES) put(`assets/${picture}`, 'jpg', 'image/jpeg');
+    put('manifest.webmanifest', '{"start_url":"./"}', 'application/manifest+json');
+    put('icon.svg', '<svg xmlns="http://www.w3.org/2000/svg"/>', 'image/svg+xml');
+    for (const png of ['apple-touch-icon.png', 'icon-192.png', 'icon-512.png', 'og-card.png']) put(png, 'png', 'image/png');
+    put('privacy.html', `<!DOCTYPE html><html><body>privacy ${version}</body></html>`, 'text/html; charset=utf-8');
+    put('music/tokyo.m4a', 'song', 'audio/mp4');
+    for (const path of options.without ?? []) files.delete(path);
+    this.files = files;
+    this.skippedByBrowsers = new Set(options.skippedByBrowsers ?? []);
+    if (options.workerChanged || this.workerRevision === 0) this.workerRevision++;
+  }
+
+  /** The full address of a request, the way the browser's store keeps it (no #part). */
+  address(ask: Ask): string {
+    const url = new URL(typeof ask === 'string' ? ask : ask.url, this.workerUrl);
+    url.hash = '';
+    return url.href;
+  }
+
+  /** What the page fetches once it runs and nobody is waiting: other languages, guide pictures. */
+  lazy(): string[] {
+    return [...this.files.keys()].filter((path) => /^assets\/([a-z]{2}-|t-|home-)/.test(path)).map((path) => this.base + path);
+  }
+
+  /** How often the host was asked for a path since the list was last cleared. */
+  timesAsked(path: string): number {
+    return this.asked.filter((asked) => asked === path).length;
+  }
+
+  track<T>(work: () => Promise<T>): Promise<T> {
+    this.busy++;
+    return work().finally(() => void this.busy--);
+  }
+
+  /** The network, for the page and for the worker alike. */
+  readonly fetch = (ask: Ask): Promise<Response> =>
+    this.track(async () => {
+      const url = this.address(ask);
+      if (!this.online || !url.startsWith(this.base)) throw new TypeError('Failed to fetch');
+      const path = url.slice(this.base.length).split('?')[0]; // a static host ignores ?queries
+      this.asked.push(path);
+      const file = this.files.get(path);
+      if (!file) return new Response('<!DOCTYPE html><title>Not found</title>', { status: 404, headers: { 'content-type': 'text/html; charset=utf-8' } });
+      const headers = { 'content-type': file.type, 'cache-control': 'max-age=600', vary: 'Accept-Encoding' };
+      const answer = new Response(file.body, { status: 200, headers });
+      if (this.pageCopyCannotBeRead && path === '') return withUnreadableCopies(answer);
+      // A browser follows a redirect for the worker's own requests; a page load it follows itself.
+      const plain = typeof ask === 'string' || ask.mode !== 'navigate';
+      return this.redirectsThePage && plain && (path === '' || path === 'index.html') ? arrivedByRedirect(answer) : answer;
+    });
+}
+
+/** An answer that reads fine itself, while every copy made of it fails to read. */
+function withUnreadableCopies(answer: Response): Response {
+  const unreadable = (): Response => {
+    const copy = new Response(null, { status: answer.status, headers: answer.headers });
+    const fail = (): Promise<never> => Promise.reject(new TypeError('the copy could not be read'));
+    Object.defineProperties(copy, { text: { value: fail }, arrayBuffer: { value: fail }, clone: { value: unreadable } });
+    return copy;
+  };
+  Object.defineProperty(answer, 'clone', { value: unreadable });
+  return answer;
+}
+
+/** Marks an answer the way a browser does when it followed a redirect to get it; copies stay marked. */
+function arrivedByRedirect(answer: Response): Response {
+  const copy = answer.clone.bind(answer);
+  Object.defineProperty(answer, 'redirected', { value: true });
+  Object.defineProperty(answer, 'clone', { value: () => arrivedByRedirect(copy()) });
+  return answer;
+}
+
+/** Waits until the pretend phone is at rest: nothing downloading, nothing being written. */
+async function settle(site: Site): Promise<void> {
+  let quiet = 0;
+  for (let turn = 0; quiet < 10; turn++) {
+    if (turn > 20000) throw new Error('the pretend phone never came to rest');
+    await new Promise((resolve) => setImmediate(resolve));
+    quiet = site.busy === 0 ? quiet + 1 : 0;
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// The browser's file store (Cache Storage)
+// ---------------------------------------------------------------------------------------------
+
+interface StoredAnswer {
+  status: number;
+  headers: [string, string][];
+  body: ArrayBuffer;
+  redirected: boolean;
+}
+
+const rebuilt = (stored: StoredAnswer): Response => {
+  const answer = new Response(stored.body, { status: stored.status, headers: stored.headers });
+  return stored.redirected ? arrivedByRedirect(answer) : answer;
+};
+
+/** A way for the store to let the worker down, to see that the player still gets an answer. */
+interface StoreFailure {
+  step: 'open' | 'match' | 'put';
+  how: 'throws' | 'rejects' | 'hangs';
+}
+
+class FakeCache {
+  readonly stored = new Map<string, StoredAnswer>();
+  /** Every address ever deleted from this cache. The worker has no reason to delete a file. */
+  readonly deleted: string[] = [];
+
+  constructor(private readonly storage: FakeCacheStorage) {}
+
+  /** The stored answer for an address, without going through the worker's own calls. */
+  peek(ask: Ask, ignoreSearch = false): StoredAnswer | undefined {
+    const wanted = this.storage.site.address(ask);
+    if (!ignoreSearch) return this.stored.get(wanted);
+    const bare = (url: string): string => url.split('?')[0];
+    for (const [url, answer] of this.stored) if (bare(url) === bare(wanted)) return answer;
+    return undefined;
+  }
+
+  match(ask: Ask, options?: { ignoreSearch?: boolean }): Promise<Response | undefined> {
+    return this.storage.step('match', async () => {
+      const hit = this.peek(ask, options?.ignoreSearch);
+      return hit ? rebuilt(hit) : undefined;
+    });
+  }
+
+  put(ask: Ask, answer: Response): Promise<void> {
+    return this.storage.step('put', async () => {
+      if (typeof ask !== 'string' && ask.method && ask.method !== 'GET') throw new TypeError('only GET requests can be stored');
+      if (answer.status === 206) throw new TypeError('a partial answer cannot be stored');
+      if (answer.bodyUsed) throw new TypeError('this answer was already read');
+      const body = await answer.arrayBuffer();
+      this.stored.set(this.storage.site.address(ask), { status: answer.status, headers: [...answer.headers.entries()], body, redirected: answer.redirected });
+    });
+  }
+
+  add(ask: Ask): Promise<void> {
+    return this.storage.site.track(async () => {
+      const answer = await this.storage.site.fetch(ask);
+      if (!answer.ok) throw new TypeError('bad status');
+      await this.put(ask, answer);
+    });
+  }
+
+  /** All or nothing, as in a browser: one bad answer and none of the files is stored. */
+  addAll(asks: Ask[]): Promise<void> {
+    return this.storage.site.track(async () => {
+      const answers = await Promise.all(
+        asks.map(async (ask) => {
+          const answer = await this.storage.site.fetch(ask);
+          if (!answer.ok) throw new TypeError('bad status');
+          return [ask, answer] as const;
+        })
+      );
+      for (const [ask, answer] of answers) await this.put(ask, answer);
+    });
+  }
+
+  async delete(ask: Ask): Promise<boolean> {
+    const url = this.storage.site.address(ask);
+    this.deleted.push(url);
+    return this.stored.delete(url);
+  }
+
+  async keys(): Promise<{ url: string }[]> {
+    return [...this.stored.keys()].map((url) => ({ url }));
+  }
+}
+
+class FakeCacheStorage {
+  readonly caches = new Map<string, FakeCache>();
+  failure: StoreFailure | null = null;
+
+  constructor(readonly site: Site) {}
+
+  /** Runs one store call, or lets it fail the way `failure` says. */
+  step<T>(name: StoreFailure['step'], work: () => Promise<T>): Promise<T> {
+    if (this.failure?.step !== name) return this.site.track(work);
+    if (this.failure.how === 'throws') throw new TypeError(`pretend store failure: ${name}`);
+    if (this.failure.how === 'rejects') return Promise.reject(new DOMException('pretend store failure: no room left', 'QuotaExceededError'));
+    return new Promise<T>(() => undefined); // never answers
+  }
+
+  open(name: string): Promise<FakeCache> {
+    return this.step('open', async () => {
+      let cache = this.caches.get(name);
+      if (!cache) this.caches.set(name, (cache = new FakeCache(this)));
+      return cache;
+    });
+  }
+
+  async keys(): Promise<string[]> {
+    return [...this.caches.keys()];
+  }
+
+  async delete(name: string): Promise<boolean> {
+    return this.caches.delete(name);
+  }
+
+  match(ask: Ask, options?: { ignoreSearch?: boolean }): Promise<Response | undefined> {
+    return this.step('match', async () => {
+      for (const cache of this.caches.values()) {
+        const hit = cache.peek(ask, options?.ignoreSearch);
+        if (hit) return rebuilt(hit);
+      }
+      return undefined;
+    });
+  }
+
+  /** The game's own cache, made on the spot for a test that fills it by hand. */
+  game(): FakeCache {
+    let cache = this.caches.get(STORE_NAME);
+    if (!cache) this.caches.set(STORE_NAME, (cache = new FakeCache(this)));
+    return cache;
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// The worker
+// ---------------------------------------------------------------------------------------------
+
+interface PretendRequest {
+  url: string;
+  method: string;
+  mode: string;
+}
+
+const navigation = (url: string): PretendRequest => ({ url, method: 'GET', mode: 'navigate' });
+const subresource = (url: string): PretendRequest => ({ url, method: 'GET', mode: 'cors' });
+
+/** One running copy of public/sw.js. A browser starts a new one whenever the file on the host changes. */
+class WorkerInstance {
+  private readonly handlers = new Map<string, ((event: unknown) => void)[]>();
+  /** Promises the worker handed to the browser that failed: work it left unfinished without noticing. */
+  readonly problems: string[] = [];
+  skipWaitingCalls = 0;
+  claimCalls = 0;
+  /** Requests the worker left to the browser (it never called respondWith). */
+  stoodAside = 0;
+  /** A browser may refuse to wait once the answer is on its way; set this to try that. */
+  refusesToWait = false;
+  /** How often the worker asked the browser, while answering a request, to keep it awake a little longer. */
+  askedToStayAwake = 0;
+
+  constructor(
+    private readonly site: Site,
+    store: FakeCacheStorage
+  ) {
+    const scope = {
+      location: new URL(site.workerUrl),
+      addEventListener: (type: string, handler: (event: unknown) => void): void => {
+        this.handlers.set(type, [...(this.handlers.get(type) ?? []), handler]);
+      },
+      skipWaiting: (): Promise<void> => {
+        this.skipWaitingCalls++;
+        return Promise.resolve();
+      },
+      clients: {
+        claim: (): Promise<void> => {
+          this.claimCalls++;
+          return Promise.resolve();
+        },
+      },
+    };
+    new Function('self', 'caches', 'fetch', 'Response', 'URL', WORKER_SOURCE)(scope, store, site.fetch, Response, URL);
+  }
+
+  listensFor(): string[] {
+    return [...this.handlers.keys()].sort();
+  }
+
+  private waitFor(label: string, work: unknown): void {
+    void this.site.track(() => Promise.resolve(work).then(() => undefined, (reason) => void this.problems.push(`${label}: ${String(reason)}`)));
+  }
+
+  /** An install, activate or message event; resolves when the worker has finished with it. */
+  async dispatch(type: 'install' | 'activate' | 'message', extra: Record<string, unknown> = {}): Promise<void> {
+    const event = { ...extra, waitUntil: (work: unknown): void => this.waitFor(type, work) };
+    for (const handler of this.handlers.get(type) ?? []) handler(event);
+    await settle(this.site);
+  }
+
+  /** The page reporting in (src/main.ts posts this once the page has loaded). */
+  message(data: unknown): Promise<void> {
+    return this.dispatch('message', { data });
+  }
+
+  /** A request from the page. Fails the way a page would see it when there is no answer. */
+  async fetch(request: PretendRequest): Promise<Response> {
+    const reply: { answer?: Promise<Response | undefined> } = {};
+    let active = true;
+    const event = {
+      request,
+      respondWith: (answer: unknown): void => {
+        reply.answer = Promise.resolve(answer) as Promise<Response | undefined>;
+      },
+      waitUntil: (work: unknown): void => {
+        if (!active || this.refusesToWait) throw new DOMException('The event is no longer active.', 'InvalidStateError');
+        this.askedToStayAwake++;
+        this.waitFor('fetch', work);
+      },
+    };
+    for (const handler of this.handlers.get('fetch') ?? []) handler(event);
+    if (!reply.answer) {
+      this.stoodAside++;
+      return this.site.fetch(request);
+    }
+    try {
+      const answer = await reply.answer;
+      if (!answer || answer.type === 'error') throw new TypeError('Failed to fetch');
+      // Browsers refuse to open a page from an answer that came through a redirect.
+      if (request.mode === 'navigate' && answer.redirected) throw new TypeError('Failed to fetch');
+      return answer;
+    } finally {
+      active = false;
+    }
+  }
+}
