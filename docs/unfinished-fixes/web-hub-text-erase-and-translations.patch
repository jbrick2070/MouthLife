+  'mouthlife.pacer.flossToolStyle': 'which floss tool the brush timer draws',
+  'mouthlife.pacer.mouthwashDurationStyle': 'the rinse length, used only once a grown-up turns rinse on again',
+  'mouthlife.reminders.morning': 'a time of day, used only once a grown-up turns reminders on again',
+  'mouthlife.reminders.evening': 'a time of day, used only once a grown-up turns reminders on again',
+};
+
+/** Erased, and what erasing means for each. */
