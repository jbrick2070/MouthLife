+/** A stand-in for the browser's localStorage (the test environment has no page). */
+function browserStorage(refuse = false): Storage {
+  const data = new Map<string, string>();
+  const guard = (): void => {
+    if (refuse) throw new Error('blocked');
+  };
+  return {
+    get length() {
+      return data.size;
+    },
+    clear: () => data.clear(),
+    key: (i) => [...data.keys()][i] ?? null,
+    getItem: (k) => (guard(), data.get(k) ?? null),
+    setItem: (k, v) => (guard(), void data.set(k, String(v))),
+    removeItem: (k) => (guard(), void data.delete(k)),
+  };
+}
+
+/** A store that can read and write but not remove, as `StorageLike` allows. */
+function storageWithoutRemove(initial: Record<string, string> = {}): StorageLike & { all(): string } {
+  const data = new Map(Object.entries(initial));
+  return {
+    getItem: (k) => data.get(k) ?? null,
+    setItem: (k, v) => void data.set(k, v),
+    all: () => [...data.values()].join('\n'),
+  };
+}
