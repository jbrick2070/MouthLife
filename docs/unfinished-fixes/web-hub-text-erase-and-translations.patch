+  storage.setItem('mouthlife.voiceCoach.language', 'de');
+  storage.setItem('mouthlife.reduceMotion', '1');
+  storage.setItem('mouthlife.pointerSteer', '0');
+  storage.setItem('mouthlife.pacer.flossToolStyle', 'stringFloss');
+  storage.setItem('mouthlife.pacer.mouthwashDurationStyle', 'quick30s');
+  // a grown-up's choices
+  writeIncludeRinse(true);
+  writeReminders({ on: true, morning: 6 * 60 + 45, evening: 20 * 60 });
+  // traces of having played
+  markHasSeenBrushIntro();
+  saveSeenHints(new Set(['first_dive', 'first_colony', COACH_DONE_HINT_KEY]));
+  const gate = new TutorialGate();
+  gate.enterHome();
+  gate.markOpened();
+  // the save, the mark of an earlier erase, and copies the save system kept of older saves
+  storage.setItem(SAVE_GENERATION_KEY, 'an-earlier-erase');
+  storage.setItem(SAVE_UNREADABLE_COPY_KEY, DAMAGED);
