+ *
+ * There is no page in the test environment. The Home screen's HTML builders are plain string
+ * functions and are called as they are; the mission report and the stage HUD are mounted on a
+ * small stand-in page that only keeps the HTML they write.
+ */
+import { readFileSync } from 'node:fs';
