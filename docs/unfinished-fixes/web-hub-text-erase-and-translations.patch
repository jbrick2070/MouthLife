+
+function memorySave(prepare?: (save: MouthLifeSaveV2) => void): SaveSystem {
+  const data = new Map<string, string>();
+  const saveSys = new SaveSystem(new EventBus(), {
+    getItem: (k) => data.get(k) ?? null,
+    setItem: (k, v) => void data.set(k, v),
+  });
+  const save = saveSys.load(T0);
+  prepare?.(save);
+  return saveSys;
+}
+
+function hubOffPage(prepare?: (save: MouthLifeSaveV2) => void): HubInside {
+  const actions = { isMuted: () => false };
+  return new CompanionHubOverlay(
+    new EventBus(),
+    memorySave(prepare),
+    actions as unknown as ConstructorParameters<typeof CompanionHubOverlay>[2]
+  ) as unknown as HubInside;
+}
+
+/** A page element that does nothing but keep what a screen writes into it. */
+interface StandInElement {
+  innerHTML: string;
+  textContent: string;
+  querySelector(selector: string): StandInElement | null;
+  [other: string]: unknown;
+}
+
+function standInElement(): StandInElement {
+  const kept = new Map<string, StandInElement>();
+  const nothing = (): void => undefined;
+  return {
+    innerHTML: '',
+    textContent: '',
+    className: '',
+    id: '',
+    style: { setProperty: nothing, removeProperty: nothing },
+    classList: { add: nothing, remove: nothing, toggle: nothing, contains: () => false },
+    dataset: {},
+    firstChild: null,
+    firstElementChild: null,
+    isConnected: true,
+    offsetWidth: 0,
+    offsetHeight: 0,
+    setAttribute: nothing,
+    removeAttribute: nothing,
+    getAttribute: () => null,
+    addEventListener: nothing,
+    removeEventListener: nothing,
+    appendChild: (child: unknown) => child,
+    remove: nothing,
+    focus: nothing,
+    blur: nothing,
+    getBoundingClientRect: () => ({ top: 0, bottom: 0, left: 0, right: 0, width: 0, height: 0 }),
+    querySelectorAll: () => [],
+    // Only the toast is handed out (to read its words back); every other part is "not on the page".
+    querySelector(selector: string) {
+      if (selector !== '#hud-toast') return null;
+      if (!kept.has(selector)) kept.set(selector, standInElement());
+      return kept.get(selector) ?? null;
+    },
+  };
+}
+
+/** Puts a stand-in page in place and returns the elements screens create on it, in order. */
+function standInPage(): StandInElement[] {
+  const created: StandInElement[] = [];
+  const nothing = (): void => undefined;
+  const store = new Map<string, string>();
+  vi.stubGlobal('document', {
+    createElement: () => {
+      const el = standInElement();
+      created.push(el);
+      return el;
+    },
+    addEventListener: nothing,
+    removeEventListener: nothing,
+    visibilityState: 'visible',
+    activeElement: null,
+    documentElement: { lang: '', classList: { contains: () => false } },
+  });
+  vi.stubGlobal('window', {
+    addEventListener: nothing,
+    removeEventListener: nothing,
+    innerWidth: 1280,
+    innerHeight: 800,
+    matchMedia: () => ({ matches: false }),
+  });
+  vi.stubGlobal('localStorage', { getItem: (k: string) => store.get(k) ?? null, setItem: (k: string, v: string) => void store.set(k, v) });
+  vi.stubGlobal('requestAnimationFrame', () => 0);
+  vi.stubGlobal('cancelAnimationFrame', nothing);
+  return created;
+}
