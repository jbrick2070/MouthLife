+  mouthlife_save_generation: 'a new mark, which tells other open tabs to take the fresh save',
+  mouthlife_save_v2_unreadable: 'removed: the copy kept of a save that could not be read',
+  mouthlife_save_v1_copy: 'removed: the copy kept of a version-1 save',
+  'mouthlife.pacer.hasSeenIntro': 'removed: the "Time Your Real Brush" card shows again',
+  'mouthlife.hintsSeen': 'emptied: the one-time hints and the first city coach come back',
+  'mouthlife.tutorial': 'back to the start: How to Play is offered again',
+  'mouthlife.pacer.includeRinse': 'off: a grown-up has to agree to the rinse step again',
+  'mouthlife.reminders.on': 'off',
+};
