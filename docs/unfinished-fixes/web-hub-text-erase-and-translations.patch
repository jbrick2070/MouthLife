+const ROOT = join(__dirname, '..');
+const T0 = 1_700_000_000_000;
+const HUB_SOURCE = readFileSync(join(ROOT, 'src/ui/CompanionHubOverlay.ts'), 'utf8');
+
+/** English words of a tooth's name, and of its nickname, that must not be left on screen. */
+const TOOTH_WORDS = ['Upper', 'Lower', 'Right', 'Left', 'Central', 'Lateral', 'Incisor', 'Canine', 'Premolar', 'Molar', 'Tooth', 'Cuspid', 'Bicuspid', 'Wisdom'];
+
+/** True when an English word or phrase is still there as a word of its own ("Par", not "Palmer"). */
+function hasWord(text: string, english: string): boolean {
+  const escaped = english.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+  return new RegExp(`(^|[^A-Za-z])${escaped}([^A-Za-z]|$)`).test(text);
+}
+
+const decode = (s: string): string =>
+  s
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;/g, "'")
+    .replace(/&amp;/g, '&');
+
+const tidy = (s: string): string => s.replace(/\s+/g, ' ').trim();
+
+/**
+ * The words on screen for a piece of HTML after the page translator has been over it. Like the
+ * translator, it takes the text between tags one run at a time: a run it knows is swapped, a run
+ * it does not know stays as written.
+ */
+function shownText(html: string, matcher: CatalogMatcher): string {
+  let out = '';
+  let last = 0;
+  for (const tag of html.matchAll(/<[^>]*>/g)) {
+    const run = decode(html.slice(last, tag.index));
+    out += /[A-Za-z]/.test(run) ? matcher.translate(run) : run;
+    last = (tag.index ?? 0) + tag[0].length;
+  }
+  const tail = decode(html.slice(last));
+  return tidy(out + (/[A-Za-z]/.test(tail) ? matcher.translate(tail) : tail));
+}
+
+/** The aria-label and title values in a piece of HTML, as the page translator leaves them. */
+function shownLabels(html: string, matcher: CatalogMatcher): string[] {
+  const out: string[] = [];
+  for (const tag of html.matchAll(/<[^>]*>/g)) {
+    for (const attr of ['aria-label', 'title']) {
+      const value = new RegExp(`${attr}="([^"]*)"`).exec(tag[0])?.[1];
+      if (value !== undefined) out.push(tidy(matcher.translate(decode(value))));
+    }
+  }
+  return out;
+}
+
+// ---------------------------------------------------------------- the screens, without a page
+
+/** The parts of the Home screen these tests call. They only build HTML. */
+interface HubInside {
+  activeModal: string;
+  chartTab: string;
