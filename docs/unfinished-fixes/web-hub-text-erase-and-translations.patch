+  /**
+   * Erase Save: a brand-new save, and nothing of the old one left on this device. On top of
+   * `resetToFreshSave` it takes away the two copies kept of a save this version could not read
+   * and of a version-1 save (H02): an erase that leaves a copy of the old progress behind is not
+   * an erase. The copies go first, so the fresh save is announced with nothing old still stored.
+   */
+  eraseSaveAndKeptCopies(nowEpochMs = Date.now()): MouthLifeSaveV2 {
+    for (const key of [SAVE_UNREADABLE_COPY_KEY, SAVE_V1_COPY_KEY]) {
+      this.memoryStore.delete(key);
+      try {
+        const storage = this.getStorage();
+        if (storage.removeItem) storage.removeItem(key);
+        // A store that cannot remove a key at least gives up the old save's bytes.
+        else if (storage.getItem(key) !== null) storage.setItem(key, '');
+      } catch {
+        // Storage refused (private browsing, blocked site data): nothing more can be done here.
+      }
+    }
+    return this.resetToFreshSave(nowEpochMs);
+  }
